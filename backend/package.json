{
  "name": "@sunnydev07/toungular-api",
  "version": "1.0.0",
  "description": "Toungular backend API with Jev decision models, Gemini 3.5, and SLA pedagogical engines",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/sunnydev07/Toungular.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "build:postgres": "npm run prisma:generate:postgres && tsc --project tsconfig.json",
    "test": "tsx --test src/services/*.test.ts src/config/*.test.ts",
    "schema:check": "node scripts/check-schema.mjs",
    "dev": "tsx --env-file=.env src/server.ts",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:generate:postgres": "prisma generate --schema prisma/postgresql/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:migrate:postgres": "prisma migrate deploy --schema prisma/postgresql/schema.prisma",
    "seed": "tsx --env-file=.env prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.29",
    "prisma": "^6.16.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  },
  "prisma": { "seed": "tsx --env-file=.env prisma/seed.ts" }
}
