// PostgreSQL deployment schema. Generated from ../schema.prisma; only the datasource provider differs.
// Model parity is enforced by src/config/schema-parity.test.ts and npm run schema:check.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String                @id @default(cuid())
  email          String                @unique
  passwordHash   String
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  profile        Profile?
  refreshTokens  RefreshToken[]
  progress       LessonProgress[]
  reviews        ReviewSchedule[]
  sessions       SpeakingSession[]
  conversations  Conversation[]
  ieltsAttempts  IeltsAttempt[]
  skillSnapshots SkillSnapshot[]
  streak         StreakState?
  referral       Referral?
  entitlements   PurchaseEntitlement[]
  exposure       ExposureProgress[]
  mastery        MasteryXp?
  idempotencyKeys IdempotencyKey[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  familyId  String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([userId, familyId])
}

model Profile {
  id           String   @id @default(cuid())
  userId       String   @unique
  goals        String   @default("[]")
  proficiency  String   @default("beginner")
  dailyMinutes Int      @default(15)
  timezone     String   @default("UTC")
  ieltsIntent  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Course {
  id          String   @id
  title       String
  description String
  level       String
  position    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lessons     Lesson[]

  @@unique([position])
}

model Lesson {
  id            String           @id
  courseId      String
  title         String
  summary       String
  content       String
  vocabularyIds String           @default("[]")
  durationMin   Int
  position      Int
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  course        Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress      LessonProgress[]

  @@unique([courseId, position])
}

model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  completedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, completedAt])
}

model VocabularyItem {
  id           String           @id
  word         String           @unique
  partOfSpeech String
  definition   String
  example      String
  level        String
  tier            Int              @default(2)
  createdByUserId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  schedules       ReviewSchedule[]

  @@index([createdByUserId])
}

model ReviewSchedule {
  id             String         @id @default(cuid())
  userId         String
  vocabularyId   String
  dueAt          DateTime
  intervalDays   Int            @default(0)
  repetitions    Int            @default(0)
  easeFactor     Float          @default(2.5)
  lapses         Int            @default(0)
  lastGrade      String?
  lastRecallMode String?
  source         String         @default("catalog")
  context        String?
  lastReviewedAt DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabulary     VocabularyItem @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  @@unique([userId, vocabularyId])
  @@index([userId, dueAt])
  @@index([userId, lastReviewedAt])
}

model SpeakingSession {
  id          String    @id @default(cuid())
  userId      String
  type        String
  status      String    @default("draft")
  prompt      String
  transcript  String?
  feedback    String?
  audioUrl    String?
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  deletedAt   DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([userId, completedAt])
}

model Conversation {
  id         String             @id @default(cuid())
  userId     String
  scenarioId String
  status     String             @default("active")
  summary    String?
  createdAt  DateTime           @default(now())
  finishedAt DateTime?
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  turns      ConversationTurn[]

  @@index([userId, createdAt])
  @@index([userId, finishedAt])
}

model ConversationTurn {
  id             String       @id @default(cuid())
  conversationId String
  role           String
  transcript     String?
  text           String
  audioUrl       String?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model IeltsAttempt {
  id         String                 @id @default(cuid())
  userId     String
  mockId     String
  status     String                 @default("in_progress")
  startedAt  DateTime               @default(now())
  finishedAt DateTime?
  feedback   String?
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  responses  IeltsAttemptResponse[]

  @@index([userId, startedAt])
  @@index([userId, finishedAt])
}

model IeltsAttemptResponse {
  id         String       @id @default(cuid())
  attemptId  String
  sectionId  String
  transcript String?
  audioUrl   String?
  feedback   String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  attempt    IeltsAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, sectionId])
}

model SkillSnapshot {
  id         String   @id @default(cuid())
  userId     String
  skill      String
  value      Float?
  source     String
  recordedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, skill, recordedAt])
}

model StreakState {
  id             String    @id @default(cuid())
  userId         String    @unique
  currentDays    Int       @default(0)
  longestDays    Int       @default(0)
  lastActivityOn DateTime?
  reminderTime   String?
  reminderDays   String    @default("[]")
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Referral {
  id           String    @id @default(cuid())
  userId       String    @unique
  code         String    @unique
  referredById String?
  redeemedAt   DateTime?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([referredById])
}

model PurchaseEntitlement {
  id            String    @id @default(cuid())
  userId        String
  productId     String
  status        String    @default("inactive")
  source        String
  purchaseToken String?   @unique
  startsAt      DateTime?
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, expiresAt])
}

model ExposureProgress {
  id              String    @id @default(cuid())
  userId          String
  level           Int
  sessions        Int       @default(0)
  lastPracticedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, level])
}

model MasteryXp {
  id            String   @id @default(cuid())
  userId        String   @unique
  fluencyXp     Int      @default(0)
  lexicalXp     Int      @default(0)
  acousticXp    Int      @default(0)
  interactionXp Int      @default(0)
  totalXp       Int      @default(0)
  level         Int      @default(1)
  rankTitle     String   @default("Apprentice")
  freezeTokens  Int      @default(2)
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model IdempotencyKey {
  id        String   @id @default(cuid())
  userId    String
  scope     String
  key       String
  response  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scope, key])
  @@index([createdAt])
}
