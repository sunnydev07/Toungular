# Local server and persistence
PORT=3000
DATABASE_URL="file:../storage/toungular.db"
JWT_SECRET=CHANGE_ME_USE_A_UNIQUE_LOCAL_DEVELOPMENT_SECRET
MOBILE_ORIGIN=http://localhost:3000

# Provider credentials are deliberately not defined here. Later integrations
# must keep Toungular-owned speech, AI, billing, storage, and ad secrets on the server.

# Generative AI (System Two: Gemini 3.5 Flash-Lite)
# GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# Voice providers (optional; the API reports unavailable until one is configured)
# GOOGLE_TTS_API_KEY=
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# OPENAI_API_KEY=
# DEEPGRAM_API_KEY=
# OPENCODE_ZEN_API_KEY=
# OPENCODE_ZEN_BASE_URL=https://api.opencode.ai/v1
# VOICE_CACHE_DIR=storage/audio-cache
